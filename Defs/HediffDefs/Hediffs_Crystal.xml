<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>CrystalGogglesHediff</defName>
    <label>crystal goggles vision</label>
    <description>Enhanced vision from crystal goggles.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>0.1</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped"/>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>CrystalItemGlowHediff</defName>
    <label>crystal glow</label>
    <description>A soft crystal glow emanates from equipped crystal items.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
    <comps />
  </HediffDef>

  <!-- 透晶神针：麻痹（清醒但不能动，敌我通用） -->
  <HediffDef>
    <defName>CrystalNeedleParalysis</defName>
    <label>crystal needle paralysis</label>
    <description>A trans-crystal nerve lock from the divine needle. The target remains conscious but cannot move.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.01</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1500~2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- 透晶神针：针灸（友军，倒计时结束痊愈） -->
  <HediffDef>
    <defName>CrystalAcupuncture</defName>
    <label>crystal acupuncture</label>
    <description>Trans-crystal acupuncture energy flows through the body's meridians, accelerating recovery. When the session completes, most diseases, wounds and blood loss will be cured. Chronic conditions, implants and permanent scars are beyond its reach.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <regeneration>40</regeneration>
        <naturalHealingFactor>2.0</naturalHealingFactor>
        <statOffsets>
          <ImmunityGainSpeed>0.3</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="CrystalTech.HediffCompProperties_CureOnExpire">
        <cureDelayTicks>60000</cureDelayTicks>
      </li>
    </comps>
  </HediffDef>

  <!-- 透晶神针：血崩（敌军，持续出血，封顶不致死） -->
  <HediffDef>
    <defName>CrystalHemorrhage</defName>
    <label>crystal hemorrhage</label>
    <description>The divine needle's strike has opened the target's blood vessels to crystalline resonance. Blood drains steadily until the resonance fades. It will not kill on its own, but leaves the victim severely weakened.</description>
    <hediffClass>CrystalTech.Hediff_CrystalHemorrhage</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>CrystalRegenerationHediff</defName>
    <label>crystal regeneration</label>
    <description>Crystalline regenerative energy courses through the body, accelerating wound healing and boosting immunity.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <regeneration>80</regeneration>
        <naturalHealingFactor>3.0</naturalHealingFactor>
        <statOffsets>
          <ImmunityGainSpeed>0.5</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

</Defs>
