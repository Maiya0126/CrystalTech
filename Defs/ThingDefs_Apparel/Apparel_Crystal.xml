<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 透晶隐形眼镜 -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Apparel_CrystalContactLens</defName>
    <stuffCategories Inherit="False" />
    <label>crystal contact lens</label>
    <description>An advanced lens made of crystal material, virtually invisible when worn. Provides enhanced targeting assistance and predictive movement analysis for melee evasion.</description>
    <techLevel>Spacer</techLevel>
    <generateCommonality>0</generateCommonality>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/CrystalContactLens</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>0.5</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>30</MaxHitPoints>
      <Mass>0.01</Mass>
      <MarketValue>1200</MarketValue>
      <WorkToMake>8000</WorkToMake>
      <Beauty>0</Beauty>
    </statBases>
    <equippedStatOffsets>
      <ShootingAccuracyPawn>0.1</ShootingAccuracyPawn>
      <MeleeDodgeChance>0.1</MeleeDodgeChance>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Eyes</li>
      </bodyPartGroups>
      <layers>
        <li>EyeCover</li>
      </layers>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <tags Inherit="False" />
    </apparel>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1</glowRadius>
        <glowColor>(200,200,195,0)</glowColor>
      </li>
    </comps>
    <costList>
      <CrystalMaterial>5</CrystalMaterial>
      <ComponentSpacer>1</ComponentSpacer>
      <Gold>2</Gold>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
    </recipeMaker>
    <tradeTags Inherit="False" />
    <researchPrerequisites>
      <li>CrystalTech</li>
    </researchPrerequisites>
  </ThingDef>

