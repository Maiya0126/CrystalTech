<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>CrystalMaterial</defName>
    <label>crystal material</label>
    <description>A transparent crystalline material with unique optical and conductive properties. Used to craft transparent buildings, weapons and apparel. As a metallic material, it can be used to forge weapons and armor with boosted sharp damage and attack speed, reduced weight and fireproof nature, though its brittleness means lower durability and armor rating. Its self-cleaning surface and light-transmitting capabilities make it ideal for high-tech construction.</description>
    <graphicData>
      <texPath>Things/Item/CrystalMaterial</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <MarketValue>30</MarketValue>
      <Mass>0.3</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <Beauty>4</Beauty>
      <StuffPower_Armor_Sharp>0.72</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.36</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.48</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>1.2</SharpDamageMultiplier>
      <BluntDamageMultiplier>0.9</BluntDamageMultiplier>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <stackLimit>300</stackLimit>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1</glowRadius>
        <glowColor>(200,220,255,0)</glowColor>
      </li>
    </comps>
    <stuffProps>
      <categories>
        <li>Crystalline</li>
        <li>Metallic</li>
      </categories>
      <appearance>Smooth</appearance>
      <color>(200,220,255)</color>
      <constructEffect>ConstructMetal</constructEffect>
      <isAirtight>true</isAirtight>
      <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Metal</soundImpactMelee>
      <statOffsets>
        <Beauty>4</Beauty>
      </statOffsets>
      <statFactors>
        <MaxHitPoints>0.7</MaxHitPoints>
        <Flammability>0</Flammability>
        <MeleeWeapon_CooldownMultiplier>0.83</MeleeWeapon_CooldownMultiplier>
        <Mass>0.5</Mass>
      </statFactors>
    </stuffProps>
  </ThingDef>

  <StuffCategoryDef>
    <defName>Crystalline</defName>
    <label>crystalline</label>
  </StuffCategoryDef>

</Defs>
