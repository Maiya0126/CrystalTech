  <!-- 透晶架子 -->
  <ThingDef ParentName="StorageShelfBase">
    <defName>TransparentShelf</defName>
    <label>transparent shelf</label>
    <description>A fireproof crystalline shelf where stored items seem suspended in frozen light, never aging, never tarnishing. Clean, organized, and quietly luminous.</description>
    <drawerType>MapMeshOnly</drawerType>
    <defaultPlacingRot>South</defaultPlacingRot>
    <graphicData>
      <texPath>Things/Building/Furniture/Shelf</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(3,2)</drawSize>
    </graphicData>
    <costStuffCount>0</costStuffCount>
    <statBases>
      <MaxHitPoints>70</MaxHitPoints>
      <Mass>8</Mass>
      <WorkToBuild>800</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>5</Beauty>
    </statBases>
    <size>(2,1)</size>
    <stuffCategories Inherit="False" />
    <costList>
      <CrystalMaterial>5</CrystalMaterial>
    </costList>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <maxItemsInCell>3</maxItemsInCell>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <paintable>false</paintable>
      <storageGroupTag>Shelf</storageGroupTag>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <categories>
            <li>Root</li>
          </categories>
          <disallowedCategories>
            <li>Chunks</li>
            <li>Plants</li>
            <li>Buildings</li>
          </disallowedCategories>
          <disallowedThingDefs MayRequire="Ludeon.RimWorld.Biotech">
            <li MayRequire="Ludeon.RimWorld.Biotech">Wastepack</li>
          </disallowedThingDefs>
          <specialFiltersToDisallow>
            <li>AllowLargeCorpses</li>
          </specialFiltersToDisallow>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Preferred</priority>
        <filter>
          <categories>
            <li>Foods</li>
            <li>Manufactured</li>
            <li>ResourcesRaw</li>
            <li>Items</li>
            <li>Weapons</li>
            <li>Apparel</li>
            <li>BodyParts</li>
          </categories>
        </filter>
      </defaultStorageSettings>
      <relatedBuildCommands>
        <li>TransparentSmallShelf</li>
      </relatedBuildCommands>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(200,200,195,0)</glowColor>
      </li>
    </comps>
    <researchPrerequisites>
      <li>CrystalTech</li>
    </researchPrerequisites>
  </ThingDef>

