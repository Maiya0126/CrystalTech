  <!-- 进阶透晶栅栏 -->
  <ThingDef ParentName="BuildingBase">
    <defName>AdvancedTransparentFence</defName>
    <label>advanced transparent fence</label>
    <description>An advanced transparent fence made of crystal material, with integrated power transmission and cloaked creature detection. Emits a soft blue glow.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <drawerType>MapMeshOnly</drawerType>
    <drawStyleCategory>Defenses</drawStyleCategory>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>80</pathCost>
    <blockWind>false</blockWind>
    <fillPercent>0</fillPercent>
    <drawDamagedOverlay>false</drawDamagedOverlay>
    <neverMultiSelect>true</neverMultiSelect>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/Linked/Fence</texPath>
      <graphicClass>Graphic_Appearances</graphicClass>
      <shaderType>Transparent</shaderType>
      <linkType>Asymmetric</linkType>
      <linkFlags>
        <li>Fences</li>
      </linkFlags>
      <asymmetricLink>
        <linkFlags>
          <li>Wall</li>
          <li>Rock</li>
        </linkFlags>
        <linkToDoors>true</linkToDoors>
        <drawDoorBorderEast>
          <color>(0,0,0)</color>
          <size>(0.04, 0.77)</size>
          <offset>(0.5, 0, -0.08)</offset>
        </drawDoorBorderEast>
        <drawDoorBorderWest>
          <color>(0,0,0)</color>
          <size>(0.04, 0.77)</size>
          <offset>(-0.5, 0, -0.08)</offset>
        </drawDoorBorderWest>
      </asymmetricLink>
      <shadowData>
        <volume>(0.3, 0.5, 0.3)</volume>
        <offset>(0,0,-0.23)</offset>
      </shadowData>
      <damageData>
        <rect>(0.35,0.1,0.3,0.7)</rect>
      </damageData>
    </graphicData>
    <castEdgeShadows>false</castEdgeShadows>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>10</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>5</Beauty>
    </statBases>
    <costList>
      <CrystalMaterial>2</CrystalMaterial>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Structure</designationCategory>
    <uiOrder>2017</uiOrder>
    <uiIconPath>Things/Building/Linked/Fence_MenuIcon</uiIconPath>
    <replaceTags>
      <li>Wall</li>
    </replaceTags>
    <building>
      <isInert>true</isInert>
      <isFence>true</isFence>
      <isPlaceOverableWall>true</isPlaceOverableWall>
      <paintable>false</paintable>
      <relatedBuildCommands>
        <li>AdvancedTransparentFenceGate</li>
      </relatedBuildCommands>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/Fence_Blueprint</texPath>
        <graphicClass>Graphic_Appearances</graphicClass>
      </blueprintGraphicData>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTransmitter</compClass>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(128,153,255,0)</glowColor>
      </li>
    </comps>
    <researchPrerequisites>
      <li>CrystalAdvanced</li>
      <li>Electricity</li>
    </researchPrerequisites>
  </ThingDef>

