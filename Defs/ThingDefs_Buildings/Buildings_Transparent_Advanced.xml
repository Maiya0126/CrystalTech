<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 进阶透晶墙 -->
  <ThingDef ParentName="BuildingBase">
    <defName>AdvancedTransparentWall</defName>
    <label>advanced transparent wall</label>
    <description>An advanced transparent wall made of crystal material, with integrated power transmission, vacuum isolation, self-cleaning surface, solar power generation, and cloaked creature detection. Emits a soft blue glow. Fireproof and highly durable.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <drawerType>MapMeshOnly</drawerType>
    <drawStyleCategory>Walls</drawStyleCategory>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <canOverlapZones>false</canOverlapZones>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <drawDamagedOverlay>false</drawDamagedOverlay>
    <neverMultiSelect>true</neverMultiSelect>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/Linked/Wall</texPath>
      <graphicClass>Graphic_Appearances</graphicClass>
      <shaderType>Transparent</shaderType>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Wall</li>
        <li>Rock</li>
      </linkFlags>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
        <edgeTop>Damage/Edge</edgeTop>
        <edgeBot>Damage/Edge</edgeBot>
        <edgeLeft>Damage/Edge</edgeLeft>
        <edgeRight>Damage/Edge</edgeRight>
      </damageData>
    </graphicData>
    <castEdgeShadows>false</castEdgeShadows>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>200</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>8</Beauty>
      <Cleanliness>0.3</Cleanliness>
    </statBases>
    <costList>
      <CrystalMaterial>2</CrystalMaterial>
      <Silver>1</Silver>
    </costList>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <holdsRoof>true</holdsRoof>
    <blockLight>false</blockLight>
    <blockWind>true</blockWind>
    <designationCategory>Structure</designationCategory>
    <uiOrder>2014</uiOrder>
    <uiIconPath>Things/Building/Linked/WallSmooth_MenuIcon</uiIconPath>
    <replaceTags>
      <li>Wall</li>
    </replaceTags>
    <building>
      <isAirtight>true</isAirtight>
      <isWall>true</isWall>
      <canExchangeVacuum>true</canExchangeVacuum>
      <relatedBuildCommands>
        <li>AdvancedTransparentDoor</li>
        <li>AdvancedTransparentAutodoor</li>
        <li>TransparentVent</li>
        <li>CrystalFloorWindow</li>
      </relatedBuildCommands>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/Wall_Blueprint_Atlas</texPath>
      </blueprintGraphicData>
    </building>
    <comps>
      <li Class="CrystalTech.CompProperties_PowerPlantTransparentWall">
        <basePowerConsumption>-25</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(128,153,255,0)</glowColor>
      </li>
      <li Class="CrystalTech.CompProperties_CrystalDetector">
        <detectionRadius>15</detectionRadius>
      </li>
    </comps>
    <researchPrerequisites>
      <li>CrystalAdvanced</li>
      <li>Electricity</li>
    </researchPrerequisites>
  </ThingDef>

